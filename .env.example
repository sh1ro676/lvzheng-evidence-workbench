# 复制本文件为 .env，并填入你的 DeepSeek 官方 API Key。
# .env 已被 Git 忽略，不会进入前端构建产物。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 联网搜索与网页读取复用上述密钥；以下为可选参数。
DEEPSEEK_WEB_TIMEOUT=45
DEEPSEEK_WEB_CONTENT_CHARS=16000

# 北大法宝 MCP Access Token，只填写 Token 本身，不要添加 Bearer 前缀。
# 仅本地 Python 后端读取；不要复制到前端、聊天记录或 Git。
PKULAW_AUTH_TOKEN=
# 思考模式：off 更快更省（推荐）；on 会显著变慢变贵，且可能耗尽 max_tokens
DEEPSEEK_THINKING=off
# 仅当 DEEPSEEK_THINKING=on 时生效：low / high / max
DEEPSEEK_REASONING_EFFORT=high
